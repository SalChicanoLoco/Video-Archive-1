# Whisper model size: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL_SIZE=large-v3
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# Anthropic — required for EDL generation, optional for transcription-only runs
ANTHROPIC_API_KEY=

# EDL defaults — override per-file via the API or set these for batch runs
EDL_THEME=selects
EDL_CRITERIA=Select the most significant, clearly spoken moments. Prefer complete thoughts over fragments.

# These match the container volume mounts — don't change unless you know why
INPUT_ROOT=/app/input
OUTPUT_ROOT=/app/output
