# ── Required on the USB stick ─────────────────────────────────────────────────
# These two values are the ONLY credentials that need to travel with the stick.
# Everything else (including ANTHROPIC_API_KEY) lives in Airtable's Config table.
AIRTABLE_API_KEY=pat...
AIRTABLE_BASE_ID=app...

# ── Optional: override the Airtable Config table name (default: Config) ───────
# AIRTABLE_CONFIG_TABLE=Config

# ── Whisper settings ──────────────────────────────────────────────────────────
WHISPER_MODEL_SIZE=large-v3
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true

# ── EDL defaults (can also be set per-file via the API) ──────────────────────
EDL_THEME=selects
EDL_CRITERIA=Select the most significant, clearly spoken moments. Prefer complete thoughts over fragments.

# ── Volume mount roots — don't change unless you know why ────────────────────
INPUT_ROOT=/app/input
OUTPUT_ROOT=/app/output

# ── Fallback: set ANTHROPIC_API_KEY here ONLY if you're not using Airtable ───
# ANTHROPIC_API_KEY=sk-ant-...
