APP_NAME=Video Archive API
APP_ENV=dev
TRANSCRIPTION_PROVIDER=mock
LOG_LEVEL=INFO
# Comma-separated plugin specs: name=module.path:ClassName
# PROVIDER_PLUGINS=whisper=app.providers_ext.whisper:WhisperProvider
PROVIDER_PLUGINS=
# memory | sqlite
JOB_STORE_BACKEND=memory
SQLITE_DB_PATH=data/jobs.db
APP_PORT=8000
# Optional API auth header value (x-api-key)
API_KEY=
MAX_RETRIES=2
RETRY_BACKOFF_SECONDS=2
