APP_NAME=Video Archive API
APP_ENV=dev
LOG_LEVEL=INFO
PROVIDER_PLUGINS=
JOB_STORE_BACKEND=memory
SQLITE_DB_PATH=data/jobs.db
APP_PORT=8000
API_KEY=

# ── Airtable (required) ───────────────────────────────────────────────────────
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Table names — change only if your Airtable base uses different names
AIRTABLE_TABLE_TAPES=Tapes
AIRTABLE_TABLE_TRANSCRIPTS=Transcripts
AIRTABLE_TABLE_EDLS=EDLs
AIRTABLE_TABLE_LOG=Operation Log

# ── Anthropic (required) ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Whisper ───────────────────────────────────────────────────────────────────
# Model size: tiny | base | small | medium | large-v2 | large-v3
WHISPER_MODEL=large-v3

# ── Directories (defaults match Docker volume mounts) ─────────────────────────
INPUT_DIR=/app/input
OUTPUT_DIR=/app/output
MODELS_DIR=/opt/whisper_cache
